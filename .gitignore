# Build directories
build/
cmake-build-*/
out/

# CMake / Conan
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CMakeUserPresets.json
CMakePresets.json.bak

# Ninja
.ninja_log
.ninja_deps

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / runtime
*.log
core
!argus-tunnel/src/core/
argus.db
database/*.db
database/*.db-wal
database/*.db-shm

# TTS models (downloaded separately). A trailing-slash rule would exclude the
# directory itself, and git cannot re-include anything under an excluded
# directory, so the exclusion is on the contents.
models/*
# The intent classifier is the one published artifact versioned in-repo (D3):
# 12.6 MB, no release infrastructure needed. Named one by one so the retired
# probe's leftovers in the same folder stay untracked.
!models/intent/
models/intent/*
!models/intent/intent.bin
!models/intent/MODEL-CARD.md

# Python cache
__pycache__/
.cache/

# Local PKI (generated by scripts/setup.sh) — never commit private keys
certs/

# Machine-specific hardware profile written by scripts/detect-hardware.sh
scripts/.hw-profile

# go2rtc release binary downloaded by scripts/setup.sh
third_party/go2rtc/

# Generated by Go2rtcManager; contains camera credentials (chmod 600)
go2rtc.yaml

# Per-installation configuration generated from config.toml.example.
config.toml

# argus-deploy per-installation runtime configs (instance secrets).
argus-deploy/config.gateway.toml
argus-deploy/config.camera.toml
argus-deploy/config.productivity.toml
argus-deploy/config.notification.toml
argus-deploy/config.tts.toml
argus-deploy/config.stt.toml
argus-deploy/config.vlm.toml
argus-deploy/config.llm.toml
argus-deploy/config.voice.toml
argus-deploy/config.memory.toml
argus-deploy/config.tunnel.toml
argus-deploy/config.relay.toml

# Docker local runtime: RustFS data, generated bucket name and credentials.
# These are instance state and must be backed up outside Git.
docker/runtime/

probe-*.wav
bench-results/
