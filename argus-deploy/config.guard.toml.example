[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
client_max_body_size = "1M"
reuse_port = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[rpc]
address = "0.0.0.0:7139"

[rpc.callers]
settings = "CHANGE_ME_SETTINGS_GUARD"
sync = "CHANGE_ME_PRESENCE_SYNC"
notification = "CHANGE_ME_PRESENCE_NOTIFICATION"
llm = "CHANGE_ME_LLM_GUARD"

[presence]
enabled = true
away_timeout_minutes = 45
tunnel_grace_seconds = 90
retention_days = 30

[database]
db = "guard/guard.db"
schema = "database/schema.sql"

[guard]
host = "0.0.0.0"
port = 7039
plain = false
min_protocol = "TLSv1.2"
enabled = true
profile = "home"
default_mode = "home"
notify_level = 2
announce_level = 3
alarm_level = 4
announce_text = "Atención: está en una propiedad privada. El propietario ya ha sido avisado."
announce_lang = "es"
greet_enabled = true
greet_known = true
greet_text = "Hola, ¿necesitas algo?"
greet_texts = "Hola, ¿necesitas algo? | Hola, ¿en qué puedo ayudarte? | Hola, ¿te ayudo en algo? | Hola, ¿todo bien?"
greet_known_text = "Hola {name}, ¿necesitas algo?"
greet_lang = "es"
greet_listen_seconds = 6
greet_reply_enabled = true
greet_reply_text = "Perfecto, dime, ¿en qué te ayudo?"
greet_reply_texts = "Perfecto, dime, ¿en qué te ayudo? | Muy bien, te escucho. | Claro, te ayudo."
greet_reply_lang = "es"
greet_repair_text = "No te escuché bien. ¿Puedes repetirlo?"
alarm_seconds = 6
arm_siren = false
siren_seconds = 20
veto_scope = "soft_only"
action_cooldown_s = 120
repeat_window_s = 86400
max_actions_per_hour = 4
expected_guests = true
cross_camera_window_s = 60
continuity_window_s = 45
signature_min_similarity = 0.82
loiter_checks = 3
staging = true
encounter_timeout_s = 300
heartbeat_s = 10
consumer_durable = "argus-guard"
decision_mode = "shadow"
health_stale_s = 300
belief_refresh_s = 300
tamper_sustained_s = 300
offline_sustained_s = 240
digest_hour = 21
regroup_window_s = 600
notify_lang = "es"

[guard.schedule]
enabled = false
asleep = "23:00-07:00"
open = ""
staffed = ""
closed_mode = "away"

[guard.quiet_hours]
enabled = false
start_hour = 22
end_hour = 7
daily_budget = 30

[guard.belief]
gate_scope = "notify"
threshold_critical = 1
threshold_high = 3
threshold_medium = 5
threshold_low = 7
detector_strong = 0.75
detector_weak = 0.35
min_score_samples = 1
persistence_windows = 2
persistence_dwell_fraction = 0.5
zone_dwell_alert_ms = 3000
zone_dwell_monitor_ms = 12000
track_stable_age_ms = 4000
track_jitter_dwell_ms = 1500
area_spread_ratio = 2.0
weight_detector_strong = 2
weight_detector_weak = -2
weight_persistence_met = 2
weight_persistence_short = -2
weight_track_stable = 1
weight_track_jitter = -2
weight_identity_unrecognized = 2
weight_identity_unobservable = -2
weight_identity_unavailable = 0
weight_identity_known = -3
weight_camera_health_degraded = -2

[guard.assess]
enabled = true
mode = "agent"
vlm_url = ""
llm_url = ""
timeout_ms = 8000
max_tool_rounds = 2

[camera]
actions_target = "argus-camera:7036"
actions_credential = "CHANGE_ME_GUARD_CAMERA"

[notifications]
grpc_target = "argus-notification:7038"
credential = "CHANGE_ME_GUARD_NOTIFICATION"

[jwt]
secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[auth]
target = "argus-auth:7043"
credential = "CHANGE_ME_GUARD_AUTH"

[identity]
target = "argus-identity:7040"
credential = "CHANGE_ME_GUARD_IDENTITY"

[nats]
url = "nats://nats:4222"
user = "argus"
password = "CHANGE_ME_NATS"

[storage]
mode = "s3"

[storage.s3]
endpoint = "http://rustfs:9000"
region = "us-east-1"
bucket = ""
access_key = ""
secret_key = ""

[mdns]
enabled = true
name = "Argus"
address = ""

[vlm]
grpc_target = "argus-vlm:7131"
grpc_credential = "CHANGE_ME_GUARD_VLM"

[llm]
grpc_target = "argus-llm:7132"
grpc_credential = "CHANGE_ME_GUARD_LLM"

[modules]
target = "argus-settings:7047"
credential = "CHANGE_ME_GUARD_MODULES"
