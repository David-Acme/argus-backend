# argus-deploy instance overrides. provision-host.sh writes the real .env
# (gitignored, 0600) with absolute host paths; instance secrets stay in the
# config.*.toml files, never here.

ARGUS_UID=1000
ARGUS_GID=1000

# External state linked into the containers.
ARGUS_DATA_DIR=./data
ARGUS_CERTS_DIR=../certs
ARGUS_MODELS_DIR=../models
ARGUS_GO2RTC_DIR=../third_party/go2rtc

# Every ${..._PORT}, ${..._MEMORY_LIMIT} and ${..._CPU_LIMIT} in the compose
# file can be overridden here. Loopback publishes:
RUSTFS_API_PORT=9000
CAMERA_PORT=7026
PRODUCTIVITY_PORT=7027
NOTIFICATION_PORT=7028
TTS_PORT=7029
STT_PORT=7030
VLM_PORT=7031
LLM_PORT=7032
VOICE_PORT=7034
VOICE_HEALTH_PORT=7035
CAMERA_GRPC_PORT=7036
PRODUCTIVITY_GRPC_PORT=7037
NOTIFICATION_GRPC_PORT=7038
GUARD_PORT=7039
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
