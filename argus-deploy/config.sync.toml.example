[server]
host = "0.0.0.0"
grpc_port = 7041

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[sync]
host = "0.0.0.0"
port = 7025
plain = false
min_protocol = "TLSv1.2"
db = "database/sync.db"
schema = "database/schema.sql"
audit_retention_days = 90
control_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[camera]
grpc_target = "argus-camera:7036"
credential = "CHANGE_ME_SYNC_CAMERA"

[identity]
target = "argus-identity:7040"
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[productivity]
grpc_target = "argus-productivity:7037"
credential = "CHANGE_ME_SYNC_PRODUCTIVITY"

[voice]
target = "argus-voice:7034"
credential = "CHANGE_ME_SYNC_VOICE"

[rtc]
enabled = true
api_key = "CHANGE_ME_LIVEKIT_KEY"
api_secret = "CHANGE_ME_LIVEKIT_SECRET"
server_url = "http://172.19.0.1:7880"
public_url = ""
public_port = 7046
token_ttl_seconds = 600

[notifications]
grpc_target = "argus-notification:7038"
credential = "CHANGE_ME_SYNC_NOTIFICATION"

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "ip"
trust_forwarded_for = false
trusted_proxy_ips = ""

[auth]
target = "argus-auth:7043"
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[guard]
presence_target = "argus-guard:7139"
presence_credential = "CHANGE_ME_PRESENCE_SYNC"

[heartbeat]
interval_seconds = 60
grace_minutes = 45
socket_grace_seconds = 180
guard_stale_seconds = 90
push_interval_seconds = 900
refill_seconds = 300

[push]
enabled = false

[nats]
url = "nats://nats:4222"
user = "argus"
password = "CHANGE_ME_NATS"
reconnect_wait_ms = 2000
max_reconnects = 60

[mdns]
enabled = true
name = "Argus"
address = ""
