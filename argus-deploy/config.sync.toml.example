
[internal_tls]
dir = "/run/secrets/internal-tls"
address = "0.0.0.0:7241"

[rpc.callers]
identity = "CHANGE_ME_IDENTITY_SYNC"
notification = "CHANGE_ME_NOTIFICATION_SYNC"
settings = "CHANGE_ME_SETTINGS_SYNC"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[sync]
host = "0.0.0.0"
port = 7025
plain = false
min_protocol = "TLSv1.2"
db = "database/sync.db"
schema = "database/schema.sql"
audit_retention_days = 90

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[camera]
grpc_target = "tls:argus-camera:7236"
credential = "CHANGE_ME_SYNC_CAMERA"

[identity]
target = "tls:argus-identity:7240"
credential = "CHANGE_ME_SYNC_IDENTITY"

[productivity]
grpc_target = "tls:argus-productivity:7237"
credential = "CHANGE_ME_SYNC_PRODUCTIVITY"

[voice]
target = "tls:argus-voice:7234"
credential = "CHANGE_ME_SYNC_VOICE"

[rtc]
enabled = true
api_key = "CHANGE_ME_LIVEKIT_KEY"
api_secret = "CHANGE_ME_LIVEKIT_SECRET"
server_url = "http://172.19.0.1:7880"
public_url = ""
public_port = 7046
token_ttl_seconds = 60
max_concurrent_calls = 2

[turn]
host = ""
port = 3478
tls_port = 5349
secret = "CHANGE_ME_TURN_SECRET"
ttl_seconds = 3600

[notifications]
grpc_target = "tls:argus-notification:7238"
credential = "CHANGE_ME_SYNC_NOTIFICATION"

[jwt]
secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[auth]
target = "tls:argus-auth:7243"
credential = "CHANGE_ME_SYNC_AUTH"

[guard]
presence_target = "tls:argus-guard:7339"
presence_credential = "CHANGE_ME_PRESENCE_SYNC"

[heartbeat]
interval_seconds = 60
grace_minutes = 45
socket_grace_seconds = 180
guard_stale_seconds = 90
refill_seconds = 300

[nats]
url = "nats://nats:4222"
nkey = ""
seed_file = "/run/secrets/nats.seed"
inbox_prefix = "_INBOX.sync"
reconnect_wait_ms = 2000
max_reconnects = 60

[mdns]
enabled = true
name = "Argus"
address = ""

[modules]
target = "tls:argus-settings:7247"
credential = "CHANGE_ME_SYNC_MODULES"
