[server]
host = "0.0.0.0"
grpc_port = 7038

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[notification]
host = "0.0.0.0"
port = 7028
plain = false
min_protocol = "TLSv1.2"

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[notifications]
db = "notification/notification.db"
schema = "database/schema.sql"
ack_window_s = 86400
selftest_interval_s = 300
budget_per_hour = 6
silent_start = -1
silent_end = -1
guard_heartbeat_timeout_s = 30
fallback_min_score_median = 0.3
fallback_min_dwell_ms = 1000
fallback_suppress_known = true
fallback_retention_days = 90
lang = "es"

[identity]
target = "argus-identity:7040"
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[nats]
url = "nats://nats:4222"
user = "argus"
password = "CHANGE_ME_NATS"
reconnect_wait_ms = 2000
max_reconnects = 60

[push]
enabled = false

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
trust_forwarded_for = true
trusted_proxy_ips = ""

[auth]
target = "argus-auth:7043"
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[grpc]
caller_guard = "CHANGE_ME_GUARD_NOTIFICATION"
caller_sync = "CHANGE_ME_SYNC_NOTIFICATION"
caller_settings = "CHANGE_ME_SETTINGS_NOTIFICATION"

[mdns]
enabled = true
name = "Argus"
address = ""
