[server]
host = "0.0.0.0"
grpc_port = 7037

[internal_tls]
dir = "/run/secrets/internal-tls"
address = "0.0.0.0:7237"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[productivity]
host = "0.0.0.0"
port = 7027
plain = false
min_protocol = "TLSv1.2"
db = "productivity/productivity.db"
schema = "database/schema.sql"

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"


[agenda]
enabled = true

[notifications]
target = "tls:argus-notification:7238"
credential = "CHANGE_ME_PRODUCTIVITY_NOTIFICATION"

[nats]
url = "nats://nats:4222"
nkey = ""
seed_file = "/run/secrets/nats.seed"
inbox_prefix = "_INBOX.productivity"
reconnect_wait_ms = 2000
max_reconnects = 60

[jwt]
secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[auth]
target = "tls:argus-auth:7243"
credential = "CHANGE_ME_PRODUCTIVITY_AUTH"

[identity]
target = "tls:argus-identity:7240"
credential = "CHANGE_ME_PRODUCTIVITY_IDENTITY"

[grpc]
caller_sync = "CHANGE_ME_SYNC_PRODUCTIVITY"
caller_settings = "CHANGE_ME_SETTINGS_PRODUCTIVITY"
caller_llm = "CHANGE_ME_LLM_PRODUCTIVITY"

[mdns]
enabled = true
name = "Argus"
address = ""

[modules]
target = "tls:argus-settings:7247"
credential = "CHANGE_ME_PRODUCTIVITY_MODULES"
