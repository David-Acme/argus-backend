# argus-deploy argus-memory configuration. Copy to config.memory.toml
# (gitignored) next to this file; the compose file bind-mounts it as the
# service's config.toml. Compose shape (F4-6): the listener binds 0.0.0.0
# inside the container — its only host exposure is the loopback-published
# 7033 listener the legacy's [memory] remote_url gate dials. Ruling CB: the
# memory.db volume is mounted into THIS service only (single owner, rw); the
# snapshot sources open read-only in-binary.

[server]
host = "0.0.0.0"
port = 7033

# The memory database this service owns (Ruling BW): a dedicated named
# volume, no other service mounts it, no DDL sidecar, no migrate tool.
[database]
file = "memory/memory.db"

[memory]
schema_file = "database/memory-schema.sql"
catalog_person_table = "catalog_person"
catalog_camera_table = "catalog_camera"
catalog_zone_table = "catalog_zone"
catalog_stream_table = "catalog_stream"
# The face recognition index belongs to the legacy process; this service
# skips it.
create_face_vec = false
queue_bound = 64
recall_max_tokens = 512
profile_max_tokens = 256
profile_max_facts = 4
profile_stale_seconds = 300
recall_deadline_ms = 200
embedding_model = "models/memory/model.onnx"
embedding_tokenizer = "models/memory/tokenizer.json"
embedding_max_len = 512
embedding_preload = true
embedding_dim = 0
recall_top_k = 4
lexical_min_hits = 4
vector_min_sim = 0.80
vector_margin = 0.05
vector_strict_min_sim = 0.88
vector_small_store_sim = 0.84
semantic_max_facts = 2
vector_dedup_sim = 0.93
chunk_chars = 400
flush_timeout_ms = 60000
compact_wait_ms = 15000
compact_max_tokens = 256
extract_wait_ms = 15000

# Per-service model subpaths (Ruling CB): the compose file binds
# models/memory and models/extract read-only at these exact paths.

[extract]
model_path = "models/extract/NuExtract-1.5-tiny-Q4_K_M.gguf"
prompt_format = "v1.5"
gpu_layers = -1
lexicon_min_coverage = 0.6
threads = 0
n_ctx = 2048
max_tokens = 512

# Worker chat leg (Ruling BZ): the workers send their chat calls to
# argus-llm over the internal network. Must be an IPv4 literal host:port
# (the raw-socket client resolves literals only) — this is why the compose
# file pins argus-llm at 172.19.0.32.
[llm]
remote_url = "172.19.0.32:7032"
remote_timeout_ms = 120000

# Read-only snapshot sources for the catalog replica boot fill (Ruling BX):
# rw mounts for the WAL -shm, mode=ro opens in-binary. The identity.db lives
# in the shared data dir the gateway creates it in; camera.db on the shared
# camera-db volume.
[identity]
db = "database/identity.db"

[camera]
db = "camera/camera.db"

[nats]
url = "nats://nats:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "8M"
client_max_memory_body_size = "8M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
