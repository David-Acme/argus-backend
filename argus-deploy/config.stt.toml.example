# argus-deploy argus-stt configuration. Copy to config.stt.toml (gitignored);
# the compose file bind-mounts it as the service's config.toml. No JWT, no
# device keys, no database; engine keys mirror the legacy [stt] block.

[server]
host = "0.0.0.0"
port = 7030

[stt]
engine = "nemo_transducer"
language = "es"

# Per-service model subpath (Ruling CB): the compose file binds models/stt
# read-only at this exact path.
models_dir = "models/stt"

# The body limit covers long PCM turns: 16 kHz mono s16 is ~32 kB per second
# of audio.
[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "64M"
client_max_memory_body_size = "64M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
