# argus-deploy argus-vlm configuration. Copy to config.vlm.toml (gitignored);
# the compose file bind-mounts it as the service's config.toml.

[server]
host = "0.0.0.0"
port = 7031

[vision]
model_path = "models/vision/lfm2vl-25/lm-Q8_0.gguf"
mmproj_path = "models/vision/lfm2vl-25/mmproj-F16.gguf"
context_size = 8192
max_tokens = 64
max_input_px = 384
image_max_tokens = 0
prompt = "Can you describe this image?"
caption_cache_slots = 8
threads = 0
# 999 offloads every layer; a GPU-less host degrades to CPU, -1 skips the attempt.
gpu_layers = 999

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "64M"
client_max_memory_body_size = "64M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
