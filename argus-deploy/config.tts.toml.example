# argus-deploy argus-tts configuration. Copy to config.tts.toml (gitignored)
# next to this file; the compose file bind-mounts it as the service's
# config.toml. Compose shape (F4-2): the listener binds 0.0.0.0 inside the
# container — its only host exposure is the loopback-published 7029 listener
# the legacy's [tts] remote_url gate dials. No JWT, no device keys, no
# database; the engine keys mirror the legacy [tts] block.

[server]
host = "0.0.0.0"
port = 7029

[tts]
threads = 0
quality = "auto"
steps_low = 6
steps_medium = 8
steps_high = 12
# This service derives its capability tier without a Vulkan probe (it links
# no ncnn) and lands on Low; pin the legacy ceiling here for parity on
# GPU-equipped hosts (12 for Balanced, 16 for High).
steps_cap = 12
speed = 1.0
max_chunk_len = 350
edge_silence_ms = 40
join_silence_ms = 90

# Per-service model subpath (Ruling CB): the compose file binds models/tts
# read-only at this exact path.
models_dir = "models/tts"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "1M"
client_max_memory_body_size = "1M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
