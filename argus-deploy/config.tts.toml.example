# argus-deploy argus-tts configuration. Copy to config.tts.toml (gitignored);
# the compose file bind-mounts it as the service's config.toml.

[server]
host = "0.0.0.0"
port = 7029

[tts]
threads = 0
quality = "auto"
steps_low = 6
steps_medium = 8
steps_high = 12
steps_cap = 12
speed = 1.0
max_chunk_len = 350
edge_silence_ms = 40
join_silence_ms = 90

models_dir = "models/tts"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "1M"
client_max_memory_body_size = "1M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
