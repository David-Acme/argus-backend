[tunnel]
secret = ""
stream_idle_seconds = 300
max_streams = 256
socket_snd_buf = 0

[server]
host = "0.0.0.0"
device_port = 7100
home_port = 7101

health_host = "0.0.0.0"
health_port = 7103

[push]
enabled = false
queue_capacity = 256

[nats]
url = "nats://nats:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "1M"
client_max_memory_body_size = "1M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
