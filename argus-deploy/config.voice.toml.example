health_port = 7035

[internal_tls]
dir = "/run/secrets/internal-tls"
address = "0.0.0.0:7234"

[grpc]
caller_sync = "CHANGE_ME_SYNC_VOICE"
caller_settings = "CHANGE_ME_SETTINGS_VOICE"
caller_notification = "CHANGE_ME_NOTIFICATION_VOICE"

[voice]
opening = "none"
trace_latency = false

[identity]
target = "tls:argus-identity:7240"
credential = "CHANGE_ME_VOICE_IDENTITY"

[rtc]
enabled = true
url = "ws://172.19.0.1:7880"
rejoin_grace_ms = 20000
first_join_wait_ms = 60000

[notification]
target = "tls:argus-notification:7238"
credential = "CHANGE_ME_VOICE_NOTIFICATION"

[camera]
grpc_target = "tls:argus-camera:7236"
credential = "CHANGE_ME_VOICE_CAMERA"

[sync]
control_target = "tls:argus-sync:7241"
control_credential = "CHANGE_ME_VOICE_SYNC_CONTROL"

[guard]
presence_target = "tls:argus-guard:7339"
presence_credential = "CHANGE_ME_GUARD_VOICE"

[watch]
enabled = true
list_refresh_ms = 10000
reconnect_ms = 2000
stage1 = "auto"
ring_ms = 2000
post_roll_ms = 1000
wake_max_distance = 2
stt_stage1_max_ms = 2500
stt_stage1_min_ms = 300
stt_stage1_min_snr_db = 6.0
kws_hangover_ms = 400
kws_retry_ms = 5000
min_wake_snr_db = 3.0
fire_debounce_ms = 1500
broadcast_window_ms = 150
broadcast_min_cameras = 3
broadcast_spread_db = 6.0
tv_raise_db = 6.0
echo_tail_ms = 800
echo_correlation = 0.6
echo_raise_db = 6.0
echo_max_lag_ms = 1000
floor_rise_db_per_s = 0.5
floor_fall_db_per_s = 10.0
fire_log_size = 200
arbitration_window_ms = 400
stage2_candidates = 2
weight_wake = 1.0
weight_snr = 0.1
weight_stage2 = 1.0
gain_weight = 0.5
gain_alpha = 0.1
end_silence_ms = 700
incomplete_hold_ms = 2000
max_turn_ms = 30000
ack_after_ms = 1500
fail_after_ms = 8000
idle_close_ms = 20000
max_length_ms = 600000
resumable_ms = 180000
reply_gap_ms = 700
camera_drop_ms = 3000
face_window_ms = 1500
belief_enabled = true
belief_min_confidence = 0.6
belief_margin = 0.2
belief_max_age_ms = 2000
visitor_consent_asks = 2
visitor_consent_max_words = 6
visitor_reply_accept_ms = 1800000
visitor_reply_hold_ms = 1800000
visitor_reply_max_chars = 300

[stt]
remote_url = ""
grpc_target = "tls:argus-stt:7330"
grpc_credential = "CHANGE_ME_VOICE_STT"
remote_timeout_ms = 30000
language = "es"

[tts]
remote_url = ""
grpc_target = "tls:argus-tts:7329"
grpc_credential = "CHANGE_ME_VOICE_TTS"
remote_timeout_ms = 30000

[llm]
remote_url = ""
grpc_target = "tls:argus-llm:7332"
grpc_credential = "CHANGE_ME_VOICE_LLM"
remote_timeout_ms = 120000

[vad]
threshold = 0.45
neg_threshold = 0.25
min_speech_frames = 5
min_silence_frames = 12
max_turn_frames = 750
pre_roll_frames = 10
min_turn_ms = 240
min_mean_prob = 0.35
denoise = true
denoise_gate_rms = 0.0035
