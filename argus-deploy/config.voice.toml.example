# argus-deploy argus-voice configuration. Copy to config.voice.toml
# (gitignored) next to this file.

[server]
host = "0.0.0.0"
grpc_port = 7034
health_port = 7035

# Gateway internal identity RPC; empty disables the spoken-name persist.
[identity]
target = "172.19.0.1:7040"
# Must match the gateway's [identity] rpc_secret, or every request 401s.
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[stt]
remote_url = "172.19.0.30:7030"
remote_timeout_ms = 30000
language = "es"

[tts]
remote_url = "172.19.0.29:7029"
remote_timeout_ms = 30000

[llm]
remote_url = "172.19.0.32:7032"
remote_timeout_ms = 120000

[vad]
threshold = 0.45
neg_threshold = 0.25
min_speech_frames = 5
min_silence_frames = 12
max_turn_frames = 750
pre_roll_frames = 10
min_turn_ms = 240
min_mean_prob = 0.35
denoise = true
denoise_gate_rms = 0.0035
