# argus-deploy argus-voice configuration. Copy to config.voice.toml
# (gitignored) next to this file. Pure gRPC voice service: no database and no
# STT/TTS/LLM model mounts — the only model is the in-process silero VAD
# (compose mounts models/vad); the gateway relays the frozen /sync voice wire
# and speaks argus.voice.v1 here.

[server]
# Bind all interfaces inside the container: the compose port publish reaches
# the listeners through the docker-proxy.
host = "0.0.0.0"
# VoiceService + grpc.health.v1 gRPC listener.
grpc_port = 7034
# Minimal /health HTTP listener for the compose healthcheck.
health_port = 7035

# Gateway internal identity RPC (IdentityService.UpdateUser); the gateway
# owns identity.db and the sync fan-out of the change. Empty disables the
# spoken-name persist. The gateway is host-networked, so its listener answers
# on the bridge gateway address.
[identity]
target = "172.19.0.1:7040"
# Fleet-shared secret sent as x-argus-fleet on every identity RPC. Must match
# [identity] rpc_secret in the gateway's config, or the filters get an
# UNAUTHENTICATED refusal and every request 401s.
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

# Transcription goes to argus-stt over the internal wire (raw-socket wires
# resolve IPv4 literals only — hence the service's static address on the
# compose subnet).
[stt]
remote_url = "172.19.0.30:7030"
remote_timeout_ms = 30000
language = "es"

# Synthesis goes to argus-tts over the internal wire.
[tts]
remote_url = "172.19.0.29:7029"
remote_timeout_ms = 30000

# Chat goes to argus-llm over the internal wire.
[llm]
remote_url = "172.19.0.32:7032"
remote_timeout_ms = 120000

# Turn detection of the voice session (in-process silero VAD).
[vad]
threshold = 0.45
neg_threshold = 0.25
min_speech_frames = 5
min_silence_frames = 12
max_turn_frames = 750
pre_roll_frames = 10
min_turn_ms = 240
min_mean_prob = 0.35
denoise = true
denoise_gate_rms = 0.0035
