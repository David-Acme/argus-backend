[gateway]
host = "0.0.0.0"
port = 7024
plain = false
min_protocol = "TLSv1.2"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "ip"

[auth]
proxy_url = "https://127.0.0.1:7042"
target = "127.0.0.1:7043"
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[identity]
proxy_url = "https://127.0.0.1:7044"

[camera]
stream_url = "wss://127.0.0.1:7026/media"
proxy_url = "https://127.0.0.1:7026"

[sync]
control_target = "127.0.0.1:7041"
control_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[productivity]
proxy_url = "https://127.0.0.1:7027"

[cert]
dir = "certs"
ca_cert = "certs/ca.pem"
ca_key = "certs/ca.key"
server_cert = "certs/server.pem"
server_key = "certs/server.key"
leaf_ttl_days = 90
rotation_threshold_days = 30
rotate_check_hours = 24

[mdns]
enabled = true
name = "Argus"

[notifications]
proxy_url = "https://127.0.0.1:7028"
credential = "CHANGE_ME_GATEWAY_NOTIFICATION"

[remote]
tunnel_port = 0
enabled = false
hostname = ""

[guard]
proxy_url = "https://127.0.0.1:7039"
