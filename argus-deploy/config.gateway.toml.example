# argus-deploy gateway configuration. Copy to config.gateway.toml (gitignored)
# next to this file and fill the instance secrets; the compose file bind-mounts
# it as the gateway's config.toml.
# Cutover shape (F1-5): the gateway owns the public TLS 7024 listener (the same
# instance certificates the legacy uses) and proxies every non-native route to
# the legacy backend on its internal plain-HTTP listener. The container runs
# host-networked (transitional Ruling O exception), so 127.0.0.1 reaches both
# the legacy listener and the published nats/rustfs ports.

[gateway]
host = "0.0.0.0"
# Public listener the mobile app has always connected to.
port = 7024
plain = false
min_protocol = "TLSv1.2"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[nats]
# Published by the compose stack on host loopback (NATS_CLIENT_PORT).
url = "nats://127.0.0.1:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

# Push intents to the home client through the tunnel transport (F5-5). The
# gateway creates the notification rows, so it carries the push_intent
# publisher alongside argus-notification (Ruling CK).
[push]
enabled = false

# Same instance secrets as the legacy backend: both binaries verify (and the
# gateway mints) the app's tokens.
[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

# Same instance secret as the legacy: the device hash must stay identical on
# both sides of the proxy.
[device]
fingerprint_secret = ""
# Device identity source: "ip" fingerprints the source IP (legacy behavior);
# "credential" replaces the IP with the per-device secret issued at
# register/login and desktop-challenge approval, presented by clients via the
# X-Argus-Device-Credential header. Flipping the mode invalidates every
# existing session once (controlled re-login).
identity_mode = "ip"

[identity]
db = "database/identity.db"
schema = "database/identity-schema.sql"
# Internal identity gRPC listener (IdentityService.UpdateUser, F6-3): the
# voice service writes the spoken name here; the gateway owns identity.db and
# re-fans the change out on argus.sync.v1.change. Bind loopback or the
# pinned internal bridge address only: the listener is row-scoped but
# unauthenticated, so it must never face a routable host interface.
rpc_host = "172.19.0.1"
rpc_port = 7040

[legacy]
sync_url = "ws://127.0.0.1:7025/sync"
proxy_url = "http://127.0.0.1:7025"
db = "database/argus.db"

[camera]
# argus-camera owns the camera domain (F2-2 CRUD, F6-2 device control).
# The camera.db path is the compose volume mounted into gateway and
# argus-camera; the gateway opens it mode=ro for the camera sync reads.
sync_url = "ws://127.0.0.1:7026/sync"
proxy_url = "http://127.0.0.1:7026"
db = "camera/camera.db"

[voice]
# F6-3 cutover: argus-voice owns the voice orchestration; the voice:* frames
# and the raw PCM binary ride the argus.voice.v1 gRPC leg at [voice].target.
# Empty keeps voice:* on the legacy WS leg ([legacy] sync_url), which since
# F6-3 answers them with the unknown-type 400 envelope — never clear this
# key once argus-voice is in the stack.
target = "127.0.0.1:7034"

[productivity]
# F3-2 cutover: argus-productivity owns the productivity routes and
# productivity.db (Rulings AP/AQ); the gateway opens it mode=ro for the
# productivity sync-table reads (Ruling AT). In the compose stack the db is
# the dedicated named volume also mounted into argus-productivity, at
# /opt/argus/productivity.
proxy_url = "http://127.0.0.1:7027"
db = "productivity/productivity.db"

# Same cert paths as the legacy (transitional shared directory): the app's
# pinned CA is byte-identical, and CertService runs here with the same keys.
[cert]
dir = "certs"
ca_cert = "certs/ca.pem"
ca_key = "certs/ca.key"
server_cert = "certs/server.pem"
server_key = "certs/server.key"
leaf_ttl_days = 90
rotation_threshold_days = 30
rotate_check_hours = 24

# The gateway advertises mDNS in the cutover runtime; the legacy disables it.
[mdns]
enabled = true
name = "Argus"
service_type = "_argus._tcp"
port = 7024

[mdns.txt]
path = "/"
https = "true"
wss = "true"

[face]
enabled = true

[notifications]
# F3-2 cutover: argus-notification owns the notification write surface and
# notification.db (Rulings AP/AR); the gateway opens it read-write because
# its NotificationService writes notifications (camera-notifier retarget,
# Ruling AR). In the compose stack the db is the dedicated named volume also
# mounted into argus-notification, at /opt/argus/notification — rw on both
# sides (Ruling AT).
proxy_url = "http://127.0.0.1:7028"
db = "notification/notification.db"
# Camera object_detected budget (Ruling AD): 6 per camera per rolling hour,
# cumulative digest for the excess, silent hours off by default.
budget_per_hour = 6
silent_start = -1
silent_end = -1

[remote]
# Fase 5 (Ruling CG): second listener the argus-tunnel client forwards to.
# 0 keeps the single-listener shape; when set (the compose tunnel profile
# pairs it with config.tunnel.toml's server.gateway_port), requests landing
# on this port are classified remote and /pairing + /auth/register answer
# 403 REMOTE_NOT_ALLOWED unless enabled = true. The listener mirrors the
# public one's TLS posture and stays unpublished — the relay is the only
# remote-facing door.
tunnel_port = 0
enabled = false
# Public relay hostname the app configures as its manual server (Fase 5,
# Ruling CI): appended as a DNS SAN to the leaf certificate. Empty keeps the
# certificate output unchanged.
hostname = ""

[rate_limit]
# Fase 5 (Ruling CJ): in-memory limiter + lockout for PATCH
# /auth/refresh-token, evaluated before filters and any DB access.
# enabled = false keeps today's behavior; a restart clears all state.
enabled = false
window_seconds = 60
max_requests = 10
lockout_threshold = 5
lockout_seconds = 300
