[settings]
host = "0.0.0.0"
port = 7045
plain = false
min_protocol = "TLSv1.2"
list_timeout_ms = 1500
update_timeout_ms = 5000
profiles_path = "profiles.json"
first_run = true
first_run_interval_s = 30

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = false
use_gzip = true
use_brotli = false
static_files_cache_time = 0
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
client_max_body_size = "64K"
reuse_port = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[owners.llm]
target = ""
credential = ""
config_file = ""

[owners.voice]
target = ""
credential = ""
config_file = ""

[owners.tts]
target = ""
credential = ""
config_file = ""

[owners.stt]
target = ""
credential = ""
config_file = ""

[owners.vlm]
target = ""
credential = ""
config_file = ""

[owners.guard]
target = ""
credential = ""
config_file = ""

[owners.camera]
target = ""
credential = ""
config_file = ""

[owners.notification]
target = ""
credential = ""
config_file = ""

[jwt]
secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[auth]
target = "argus-auth:7043"
credential = "CHANGE_ME_SETTINGS_AUTH"

[mdns]
enabled = true
name = "Argus"
address = ""
