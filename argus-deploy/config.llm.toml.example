# argus-deploy argus-llm configuration. Copy to config.llm.toml (gitignored);
# the compose file bind-mounts it as the service's config.toml. Since f8-b4
# this is the brain: the [llm] engine block drives both the wire and the tool
# loop, and the blocks below carry the hosted memory stack.

[server]
host = "0.0.0.0"
port = 7032

[llm]
model_path = "models/llm/LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf"
context_size = 32768
max_tokens = 256
temperature = 0.85
threads = 0
batch_threads = 0
n_batch = 1024
n_ubatch = 512
kv_type = "auto"
flash_attn = "auto"
swa_full = false
top_k = 20
top_p = 0.8
penalty_last_n = 64
penalty_repeat = 1.10
penalty_freq = 0.0
penalty_present = 0.0
seed = 0
chat_template = "chatml"
# The compose service ships without /dev/dri, so the engine runs CPU.
gpu_layers = -1

# The compose file binds models/llm, models/memory and models/extract read-only.

# The hosted memory stack; the memory-db volume mounts at /opt/argus/memory.
[memory]
db_file = "memory/memory.db"
schema_file = "database/memory-schema.sql"
catalog_person_table = "catalog_person"
catalog_camera_table = "catalog_camera"
catalog_zone_table = "catalog_zone"
catalog_stream_table = "catalog_stream"
# The face recognition index belongs to the face service.
create_face_vec = false
queue_bound = 64
recall_max_tokens = 512
profile_max_tokens = 256
profile_max_facts = 4
profile_stale_seconds = 300
recall_deadline_ms = 200
embedding_model = "models/memory/model.onnx"
embedding_tokenizer = "models/memory/tokenizer.json"
embedding_max_len = 512
embedding_preload = true
embedding_dim = 0
recall_top_k = 4
lexical_min_hits = 4
vector_min_sim = 0.80
vector_margin = 0.05
vector_strict_min_sim = 0.88
vector_small_store_sim = 0.84
semantic_max_facts = 2
vector_dedup_sim = 0.93
chunk_chars = 400
flush_timeout_ms = 60000
compact_wait_ms = 15000
compact_max_tokens = 256
extract_wait_ms = 15000

[extract]
model_path = "models/extract/NuExtract-1.5-tiny-Q4_K_M.gguf"
prompt_format = "v1.5"
# CPU only in the container (no /dev/dri on this service).
gpu_layers = -1
lexicon_min_coverage = 0.6
threads = 0
n_ctx = 2048
max_tokens = 512

# Read-only snapshot sources for the catalog replica boot fill.
[identity]
db = "database/identity.db"

[camera]
db = "camera/camera.db"

[nats]
# Empty skips the hosted catalog replica (the snapshot fill still runs).
url = "nats://nats:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "8M"
client_max_memory_body_size = "8M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
