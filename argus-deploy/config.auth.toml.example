[server]
host = "0.0.0.0"
grpc_port = 7043

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[auth]
host = "0.0.0.0"
port = 7042
plain = false
min_protocol = "TLSv1.2"
db = "database/auth.db"
schema = "database/schema.sql"
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"
context_cache_seconds = 30
refresh_reuse_grace_seconds = 30

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[identity]
target = "argus-identity:7040"
rpc_secret = "CHANGE_ME_SAME_IN_EVERY_SERVICE"

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[rate_limit]
enabled = true
window_seconds = 60
max_requests = 10
lockout_threshold = 5
lockout_seconds = 300

[remote]
tunnel_port = 0
enabled = false
allow_qr_login = false
tunnel_profile = false

[nats]
url = "nats://nats:4222"
user = "argus"
password = "CHANGE_ME_NATS"
reconnect_wait_ms = 2000
max_reconnects = 60

[mdns]
enabled = true
name = "Argus"
address = ""
