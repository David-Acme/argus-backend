{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "build/dev/build/Debug/generators/conan_toolchain.cmake",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "build/dev/build/Debug/generators"
      },
      "description": "Debug build with Conan 2"
    },
    {
      "name": "prod",
      "generator": "Ninja",
      "binaryDir": "build/prod",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "build/prod/build/Release/generators/conan_toolchain.cmake",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_PREFIX_PATH": "build/prod/build/Release/generators"
      },
      "description": "Release build with Conan 2"
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "jobs": 8 },
    { "name": "prod", "configurePreset": "prod", "jobs": 8 },
    { "name": "gateway", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-gateway", "gateway-test", "audit-sync-read-test",
                  "camera-notifier-test", "push-intent-test"] },
    { "name": "gateway-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-gateway", "gateway-test", "audit-sync-read-test",
                  "camera-notifier-test", "push-intent-test"] },
    { "name": "camera", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-camera", "event-intelligence-test",
                  "camera-operator-test"] },
    { "name": "camera-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-camera", "event-intelligence-test",
                  "camera-operator-test"] },
    { "name": "productivity", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-productivity", "productivity-schema-test",
                  "productivity-migration-test"] },
    { "name": "productivity-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-productivity", "productivity-schema-test",
                  "productivity-migration-test"] },
    { "name": "notification", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-notification", "notification-schema-test",
                  "notification-migration-test"] },
    { "name": "notification-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-notification", "notification-schema-test",
                  "notification-migration-test"] },
    { "name": "tts", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-tts"] },
    { "name": "tts-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-tts"] },
    { "name": "stt", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-stt"] },
    { "name": "stt-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-stt"] },
    { "name": "vlm", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-vlm"] },
    { "name": "vlm-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-vlm"] },
    { "name": "llm", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-llm"] },
    { "name": "llm-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-llm"] },
    { "name": "memory", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-memory"] },
    { "name": "memory-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-memory"] },
    { "name": "tunnel", "configurePreset": "dev", "jobs": 8,
      "targets": ["argus-tunnel-client", "argus-tunnel-relay",
                  "framing-test", "tunnel-integration-test",
                  "tunnel-reconnect-test", "tunnel-negauth-test",
                  "service-config-test"] },
    { "name": "tunnel-prod", "configurePreset": "prod", "jobs": 8,
      "targets": ["argus-tunnel-client", "argus-tunnel-relay",
                  "framing-test", "tunnel-integration-test",
                  "tunnel-reconnect-test", "tunnel-negauth-test",
                  "service-config-test"] }
  ]
}
