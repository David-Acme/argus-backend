# Lab-only configuration. It overlays the system config when a lab runs.

[labs.llm]
recall_temperature = 0.5

[labs.conversation]
history_messages = 41

[labs.voice_test]
mic_recover_timeout_ms = 3000
camera_name = ""
camera_rtsp_main = ""
camera_rtsp_sub = ""

[labs.tapo]
talk_drain_margin_ms = 800
talk_packet_ms = 20

[labs.memory]
exit_flush_ms = 4000
save_trigger = "<|tool_call_start|>"
tool_end_trigger = "<|tool_call_end|>"

[labs.intent]
usage_log = "labs/intent-data/usage.tsv"
