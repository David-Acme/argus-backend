# argus-camera configuration. Copy to config.toml (gitignored) to run.
# Camera-domain keys only (Fase 2 pilot): no AI sections. The camera tables
# live in this service's own camera.db; argus.db is never touched here.

[server]
# Internal plain-HTTP listener. Loopback by default: the gateway is the only
# public listener, and from the F2-2 cutover it routes /camera* and /zone here.
host = "127.0.0.1"
port = 7026

# Mirror of the legacy [drogon.app] block; the listener and db_clients are
# built by the service itself (see argus-camera/src/main.cc).
[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[camera]
# Own database of the camera domain (camera, camera_stream, zone), applied at
# boot from the schema below. tools/migrate-camera fills it from argus.db
# against the same config key.
db = "database/camera.db"
schema = "database/camera-schema.sql"

# Tapo local protocols (control + 8800 talk channel). Values mirror the
# legacy [tapo] block; the Fase-2 drivers read these keys.
[tapo]
control_port = 443
media_port = 8800
connect_timeout_ms = 3000
request_timeout_ms = 5000
login_attempts = 2
transport = "auto"
talk_framing = "none"
talk_mode = "aec"

# go2rtc lifecycle and the stream hub/relay windows. Values mirror the
# legacy [streaming] block; until the F2-2 cutover the legacy still owns
# every running stream.
[streaming]
go2rtc_bin = "third_party/go2rtc/go2rtc"
go2rtc_config = "go2rtc.yaml"
go2rtc_api = "127.0.0.1:1984"
go2rtc_rtsp = "127.0.0.1:8554"
max_restarts = 8
hub_window_bytes = 131072
hub_chunk_bytes = 16384
hub_grace_ms = 2000
hub_max_subs_per_client = 8
max_viewers_per_camera = 4
max_total_viewers = 8
relay_chunk_bytes = 32768

# Talk synthesis goes to argus-tts over the internal wire; with remote_url
# empty every /camera/{id}/talk call fails with a 502 CAMERA_UNREACHABLE
# envelope (no in-process engine exists in this service).
[tts]
remote_url = "127.0.0.1:7029"
remote_timeout_ms = 30000

# Change funnel of the camera domain (F2-2, Ruling Y): emits and audit diffs
# publish over NATS to the gateway, which inserts the audit rows and fans the
# changes out to /sync. Empty disables the funnel (events drop with a
# warning).
[nats]
url = "nats://127.0.0.1:4222"

# Access tokens minted by the gateway: the camera routes and the /sync socket
# validate the same JWTs and identity rows the legacy validates. The secrets
# must match the gateway's [jwt] block.
[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

# Device fingerprint of the /sync socket and the camera routes: the HMAC key
# must match the gateway's [device] block, and the forwarded-for trust makes
# the gateway's synthesized X-Forwarded-For the observed client IP.
[device]
fingerprint_secret = ""
trust_forwarded_for = true
trusted_proxy_ips = ""

# Optional: identity database opened read-only for the JwtFilter's
# refresh-token and user lookups. Point it at the gateway's identity.db;
# empty falls back to the default camera.db client (auth reads fail).
# [identity]
# db = "database/identity.db"

# Objects capacity (F2-3): the YOLO26n detector behind the IObjectDetector
# seam. With enabled = false or a missing model everything downstream stays
# inert. The class table must match the model's class count on the raw
# one2one export (row length = 4 + class count), so the full COCO-80 default
# is what the yolo26n export expects.
[objects]
enabled = false
model = "models/objects"
input_size = 640
conf = 0.45
max_fps_inference = 2.0
use_vulkan = true
# classes = "person,bicycle,car,..." (COCO-80 default when empty)

# Operator behavior (F2-3): aggregation, cooldowns, zones and schedule.
# Camera-side budget only (Ruling AD); the gateway keeps the notification
# budget and silent hours in its own [notifications] section. The operator is
# read-only toward hardware (Ruling AF): it publishes
# argus.camera.v1.object_detected to NATS and never sends camera commands.
[operator]
aggregation_window_ms = 5000
cooldown_ms = 30000
night_start = 22
night_end = 6
presence_escalation_frames = 3
overlay = false
overlay_dir = "bench-results/operator-overlay"
# ignored_classes = "bird,cat"
# zones = '[{"cameraId":1,"kind":"alert","name":"door","points":[[0.0,0.0],[1.0,0.0],[1.0,1.0]]}]'
