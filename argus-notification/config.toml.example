# argus-notification configuration. Copy to config.toml (gitignored) to run.
# Notification-domain keys only: no AI sections, no stream/socket sections.
# The notification tables live in this service's own notification.db; argus.db
# is never touched here.

[server]
# Internal plain-HTTP listener. Loopback by default: the gateway is the only
# public listener, and from the F3-2 cutover it routes the notification write
# paths here.
host = "127.0.0.1"
port = 7028

# Mirror of the legacy [drogon.app] block; the listener and db_clients are
# built by the service itself (see argus-notification/src/main.cc).
[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[notifications]
# Own database of the notification domain (notification, notification_token),
# applied at boot from the schema below. tools/migrate-notification fills it
# from argus.db against the same config key. Ruling AN: notification.db is
# single-owner — this service alone writes it.
db = "database/notification.db"
schema = "database/notification-schema.sql"

# Access tokens minted by the gateway: the routes validate the same JWTs the
# legacy validates. The secrets must match the gateway's [jwt] block.
[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

# Device fingerprint of the routes: the HMAC key must match the gateway's
# [device] block, and the forwarded-for trust makes the gateway's synthesized
# X-Forwarded-For the observed client IP.
[device]
fingerprint_secret = ""
trust_forwarded_for = true
trusted_proxy_ips = ""

# The JWT filter resolves the caller's user row (and the bound refresh-token
# session) in identity.db; without this key the boot stays identity-free and
# authenticated requests fail their user lookup. Same install as
# argus-productivity (Ruling AM).
[identity]
db = "database/identity.db"

[nats]
# The change funnel toward the gateway (Rulings AQ/AR): change emits and
# user audit diffs publish over argus.notification.v1.change. Empty disables the
# funnel; the feature services then drop their change events with a
# warning.
url = "nats://127.0.0.1:4222"

