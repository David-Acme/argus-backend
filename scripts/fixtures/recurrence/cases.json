      "zone": "America/Lima",
      "rule": "FREQ=WEEKLY",
      "anchor": "2026-10-05T08:00:00",
      "count": 3,
      "expect": ["2026-10-05T08:00:00", "2026-10-12T08:00:00", "2026-10-19T08:00:00"]
    },
    {
