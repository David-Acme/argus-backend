      "anchor": "2026-01-26T18:00:00",
      "count": 4,
      "expect": ["2026-01-26T18:00:00", "2026-02-09T18:00:00", "2026-02-23T18:00:00", "2026-03-09T18:00:00"]
    },
    {
      "name": "monthly on the 31st clamps to the month end and returns to the 31st",
      "zone": "America/Lima",
      "rule": "FREQ=MONTHLY",
      "anchor": "2026-01-31T09:00:00",
      "count": 5,
      "expect": ["2026-01-31T09:00:00", "2026-02-28T09:00:00", "2026-03-31T09:00:00", "2026-04-30T09:00:00", "2026-05-31T09:00:00"]
    },
    {
      "name": "yearly on 29 February clamps in common years",
      "zone": "America/Lima",
      "rule": "FREQ=YEARLY",
      "anchor": "2024-02-29T10:00:00",
      "count": 5,
      "expect": ["2024-02-29T10:00:00", "2025-02-28T10:00:00", "2026-02-28T10:00:00", "2027-02-28T10:00:00", "2028-02-29T10:00:00"]
    },
    {
      "name": "the first occurrence after a moment is the next future one",
      "zone": "America/New_York",
      "rule": "FREQ=DAILY",
      "anchor": "2026-03-07T08:00:00",
      "after": "2026-03-08T09:00:00",
      "expectFirst": "2026-03-09T08:00:00"
    },
    {
      "name": "a series missed for days resumes at the first future occurrence, not a replay",
      "zone": "America/Lima",
      "rule": "FREQ=DAILY",
      "anchor": "2026-10-01T08:00:00",
      "after": "2026-10-10T12:00:00",
      "expectFirst": "2026-10-11T08:00:00"
    },
    {
      "name": "a Lima series keeps 08:00 Lima when it is displayed in Madrid across Madrid's spring change",
      "zone": "America/Lima",
