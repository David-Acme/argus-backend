      "rule": "FREQ=DAILY",
      "anchor": "2026-03-07T08:00:00",
      "count": 4,
      "expect": ["2026-03-07T08:00:00", "2026-03-08T08:00:00", "2026-03-09T08:00:00", "2026-03-10T08:00:00"]
    },
    {
      "name": "every three days",
      "zone": "America/Lima",
      "rule": "FREQ=DAILY;INTERVAL=3",
