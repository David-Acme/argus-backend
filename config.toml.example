# Argus local configuration. scripts/setup.sh fills instance secrets.

[[drogon.listeners]]
address = "0.0.0.0"
port = 7024
https = true
cert = "certs/server.pem"
key = "certs/server.key"
ssl_conf = [["MinProtocol", "TLSv1.2"]]

[[drogon.db_clients]]
name = "default"
rdbms = "sqlite3"
filename = "database/argus.db"
is_fast = false
number_of_connections = 1
timeout = -1.0

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[[drogon.plugins]]
name = "drogon::plugin::AccessLogger"
dependencies = []
[drogon.plugins.config]
use_spdlog = false
log_path = ""
log_format = ""
log_file = "access.log"
log_size_limit = 0
use_local_time = true
log_index = 0

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
trust_forwarded_for = false
trusted_proxy_ips = ""
# Device identity source: "ip" fingerprints the source IP (legacy behavior);
# "credential" replaces the IP with the per-device secret issued at
# register/login and desktop-challenge approval, presented by clients via the
# X-Argus-Device-Credential header. Flipping the mode invalidates every
# existing session once (controlled re-login).
identity_mode = "ip"

[identity]
# Internal identity gRPC listener: the gateway hosts it and every service
# validates tokens and device credentials against it. Loopback needs no
# secret; the moment rpc_host is not loopback the gateway refuses to start
# without rpc_secret, because the listener is cleartext and answers verdicts
# for the whole fleet. scripts/setup.sh generates one.
rpc_host = "127.0.0.1"
rpc_port = 7040
rpc_secret = ""

[database]
file = "./database/argus.db"

[face]
top_k = 5

[llm]
# F4-5 cutover (Rulings BU/BF): with remote_url set MemoryService reaches the
# argus-llm service over the internal wire while the in-process engine still
# boots — these engine keys then feed the argus-llm service's own config (and
# keep feeding the in-process engine MemoryService reaches). With remote_url
# empty the in-process engine serves everything, exactly as before.
# remote_url must be an IPv4 host:port (the client connects IPv4 literals
# only; "localhost" resolves through the resolver and fails the connect).
remote_url = ""
remote_timeout_ms = 120000
model_path = "models/llm/LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf"
context_size = 32768
max_tokens = 256
temperature = 0.85
threads = 0
batch_threads = 0
n_batch = 1024
n_ubatch = 512
kv_type = "auto"
flash_attn = "auto"
swa_full = false
top_k = 20
top_p = 0.8
penalty_last_n = 64
penalty_repeat = 1.10
penalty_freq = 0.0
penalty_present = 0.0
seed = 0
chat_template = "chatml"
gpu_layers = -1

[vision]
# F4-4 cutover (Ruling BQ): with remote_url set the gateway boots WITHOUT the
# vision model — describes go to the argus-vlm service over the internal
# wire and the in-process engine stays uninitialized. With remote_url empty
# the in-process engine boots exactly as before and reads the keys below.
remote_url = ""
remote_timeout_ms = 120000

model_path = "models/vision/lfm2vl-25/lm-Q8_0.gguf"
mmproj_path = "models/vision/lfm2vl-25/mmproj-F16.gguf"
context_size = 8192
max_tokens = 64
max_input_px = 384
image_max_tokens = 0
prompt = "Can you describe this image?"
caption_cache_slots = 8
threads = 0
gpu_layers = -1

[tapo]
control_port = 443
media_port = 8800
connect_timeout_ms = 3000
request_timeout_ms = 5000
login_attempts = 2
transport = "auto"
talk_framing = "none"
talk_mode = "aec"

[cert]
dir = "certs"
ca_cert = "certs/ca.pem"
ca_key = "certs/ca.key"
server_cert = "certs/server.pem"
server_key = "certs/server.key"
leaf_ttl_days = 90
rotation_threshold_days = 30
rotate_check_hours = 24

[pairing]
paired = false

[mdns]
enabled = true
name = "Argus"
service_type = "_argus._tcp"
port = 7024

[mdns.txt]
path = "/"
https = "true"
wss = "true"

[streaming]
go2rtc_bin = "third_party/go2rtc/go2rtc"
go2rtc_config = "go2rtc.yaml"
go2rtc_api = "127.0.0.1:1984"
go2rtc_rtsp = "127.0.0.1:8554"
max_restarts = 8
hub_window_bytes = 131072
hub_chunk_bytes = 16384
hub_grace_ms = 2000
hub_max_subs_per_client = 8
max_viewers_per_camera = 4
max_total_viewers = 8
relay_chunk_bytes = 32768

[memory]
# F4-6 cutover (Ruling BY): with remote_url set the gateway boots WITHOUT the
# memory stack — the tool loop serves from the argus-memory service over the
# internal wire through the remote adapter. With remote_url empty the
# in-process stack boots exactly as before and reads the keys below.
# remote_url must be an IPv4 host:port (the client connects IPv4 literals
# only; "localhost" resolves through the resolver and fails the connect).
remote_url = ""
remote_timeout_ms = 120000
queue_bound = 64
recall_max_tokens = 512
profile_max_tokens = 256
profile_max_facts = 4
profile_stale_seconds = 300
recall_deadline_ms = 200
embedding_model = "models/memory/model.onnx"
embedding_tokenizer = "models/memory/tokenizer.json"
embedding_max_len = 512
embedding_preload = true
embedding_dim = 0
recall_top_k = 4
lexical_min_hits = 4
vector_min_sim = 0.80
vector_margin = 0.05
vector_strict_min_sim = 0.88
vector_small_store_sim = 0.84
semantic_max_facts = 2
vector_dedup_sim = 0.93
chunk_chars = 400
flush_timeout_ms = 60000
compact_wait_ms = 15000
compact_max_tokens = 256
extract_wait_ms = 15000

[extract]
model_path = "models/extract/NuExtract-1.5-tiny-Q4_K_M.gguf"
prompt_format = "v1.5"
gpu_layers = -1
lexicon_min_coverage = 0.6
threads = 0
n_ctx = 2048
max_tokens = 512

[nats]
url = "nats://127.0.0.1:4222"
reconnect_wait_ms = 2000
max_reconnects = 60
