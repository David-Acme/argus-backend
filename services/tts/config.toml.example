[server]
host = "127.0.0.1"
port = 7029

[rpc]
address = ""

[rpc.callers]
voice = ""
camera = ""
settings = ""

[tts]
threads = 0
quality = "auto"
steps_low = 6
steps_medium = 8
steps_high = 12
steps_cap = 0
speed = 1.0
max_chunk_len = 350
edge_silence_ms = 40
join_silence_ms = 90

models_dir = "models/tts"
pocket_models_dir = ""

engine_es = "pocket"
engine_en = "pocket"
pocket_variant_es = "quality"
pocket_voice_es = "jean"
pocket_voice_en = "jean"
pocket_reference_es = ""
pocket_reference_en = ""
pocket_precision = "int8"
pocket_temperature = 0.3
pocket_lsd_steps = 1
normalize_text = true

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "1M"
client_max_memory_body_size = "1M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
