[tunnel]
secret = ""

reconnect_wait_ms = 2000
reconnect_max_wait_ms = 60000
ping_interval_seconds = 30

stream_idle_seconds = 300
max_streams = 256
max_streams_per_ip = 32
socket_snd_buf = 0

[server]
host = "0.0.0.0"
device_port = 7100
home_port = 7101

relay_host = "127.0.0.1"
relay_port = 7101
gateway_host = "127.0.0.1"
gateway_port = 7142

health_host = "127.0.0.1"
health_port = 7103

[link]
enabled = false
home_id = ""
host = "argus-tunnel.lynk.page"
port = 7001
certificate_path = "certs/link.crt"
key_path = "certs/link.key"
node_certificate_path = "certs/cloud.crt"

keepalive_active_seconds = 20
keepalive_idle_seconds = 90
keepalive_pong_timeout_seconds = 15
dead_link_seconds = 240
hello_timeout_seconds = 10

reconnect_base_ms = 1000
reconnect_cap_ms = 60000

stream_idle_seconds = 300
max_streams = 256
device_domain_suffix = ".argus-tunnel.lynk.page"

[link.services]
auth = 7142
identity = 7144

[push]
enabled = false
queue_capacity = 256

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "1M"
client_max_memory_body_size = "1M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
