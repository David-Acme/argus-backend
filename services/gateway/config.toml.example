[gateway]
host = "0.0.0.0"
port = 7024
plain = false
min_protocol = "TLSv1.2"
db = "database/gateway.db"
schema = "services/gateway/database/schema.sql"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[nats]
url = ""
reconnect_wait_ms = 2000
max_reconnects = 60

[push]
enabled = false

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "ip"

[auth]
proxy_url = "https://127.0.0.1:7042"
target = "127.0.0.1:7043"
rpc_secret = ""

[identity]
db = "database/identity.db"
schema = "packages/identity/database/schema.sql"
rpc_host = "127.0.0.1"
rpc_port = 7040

[camera]
stream_url = "ws://127.0.0.1:7026/media"
proxy_url = "http://127.0.0.1:7026"

[sync]
control_target = "127.0.0.1:7041"
control_secret = ""

[productivity]
proxy_url = "http://127.0.0.1:7027"
db = "database/productivity.db"

[cert]
dir = "certs"
ca_cert = "certs/ca.pem"
ca_key = "certs/ca.key"
server_cert = "certs/server.pem"
server_key = "certs/server.key"
leaf_ttl_days = 90
rotation_threshold_days = 30
rotate_check_hours = 24

[mdns]
enabled = true
name = "Argus"
service_type = "_argus._tcp"
port = 7024

[mdns.txt]
path = "/"
https = "true"
wss = "true"

[face]
enabled = true

[notifications]
proxy_url = "http://127.0.0.1:7028"
db = "database/notification.db"
budget_per_hour = 6
silent_start = -1
silent_end = -1
credential = ""
guard_heartbeat_timeout_s = 30
fallback_min_score_median = 0.3
fallback_min_dwell_ms = 1000
fallback_suppress_known = true
fallback_retention_days = 90

[remote]
tunnel_port = 0
enabled = false
hostname = ""

[guard]
proxy_url = "http://127.0.0.1:7039"
