[server]
host = "127.0.0.1"
port = 7030

[internal_tls]
dir = ""
address = "127.0.0.1:7330"

[rpc.callers]
voice = ""
camera = ""
settings = ""

[stt]
engine = "nemo_transducer"
language = "es"

models_dir = "models/stt"

[kws]
model_dir = "models/kws"
encoder = "encoder.onnx"
decoder = "decoder.onnx"
joiner = "joiner.onnx"
tokens = "tokens.txt"
keywords_file = "keywords.txt"
threshold = 0.25
score = 1.5
max_active_paths = 4
trailing_blanks = 1
threads = 1

[components]
models_dir = "models"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "4M"
client_max_memory_body_size = "4M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
