# argus-guard configuration. Copy to config.toml (gitignored) to run.

[server]
host = "127.0.0.1"
port = 7039

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
client_max_body_size = "1M"
reuse_port = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[database]
db = "database/guard.db"
schema = "services/argus-guard/database/schema.sql"

[guard]
enabled = false
profile = "home"
default_mode = "home"
notify_level = 2
announce_level = 3
alarm_level = 4
announce_text = "Hola, ¿necesitas algo?"
announce_lang = "es"
greet_enabled = true
greet_known = true
greet_text = "Hola, ¿necesitas algo?"
greet_texts = "Hola, ¿necesitas algo? | Hola, ¿en qué puedo ayudarte? | Hola, ¿te ayudo en algo? | Hola, ¿todo bien?"
greet_known_text = "Hola {name}, ¿necesitas algo?"
greet_lang = "es"
greet_listen_seconds = 6
greet_reply_enabled = true
greet_reply_text = "Perfecto, dime, ¿en qué te ayudo?"
greet_reply_texts = "Perfecto, dime, ¿en qué te ayudo? | Muy bien, te escucho. | Claro, te ayudo."
greet_reply_lang = "es"
greet_repair_text = "No te escuché bien. ¿Puedes repetirlo?"
alarm_seconds = 6
arm_siren = false
siren_seconds = 20
veto_scope = "soft_only"
action_cooldown_s = 120
repeat_window_s = 86400
max_actions_per_hour = 4
# Bounded dialogue turns and poison-message handling.
max_dialogue_turns = 3
max_observation_attempts = 5
max_announce_words = 12
expected_guests = true
cross_camera_window_s = 60
continuity_window_s = 20
signature_min_similarity = 0.82
loiter_checks = 3
staging = true
encounter_timeout_s = 300
heartbeat_s = 10
consumer_durable = "argus-guard"

[guard.assess]
enabled = true
mode = "agent"
vlm_url = "http://127.0.0.1:7031"
llm_url = "127.0.0.1:7032"
timeout_ms = 8000
max_tool_rounds = 2

[camera]
actions_target = "127.0.0.1:7036"
# Caller capability credential for the guard -> camera edge.
actions_credential = ""

[notifications]
grpc_target = "127.0.0.1:7038"
# Caller capability credential for the guard -> notification edge.
credential = ""

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "ip"
trust_forwarded_for = true
trusted_proxy_ips = ""

[identity]
target = "127.0.0.1:7040"
rpc_secret = ""

[nats]
url = "nats://127.0.0.1:4222"
