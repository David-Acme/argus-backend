[server]
host = "127.0.0.1"
port = 7032

[rpc]
address = ""

[rpc.callers]
guard = ""
voice = ""
memory = ""
settings = ""

[llm]
model_path = "models/llm/LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf"
context_size = 32768
max_tokens = 256
temperature = 0.3
threads = 0
batch_threads = 0
n_batch = 1024
n_ubatch = 512
kv_type = "auto"
flash_attn = "auto"
swa_full = false
top_k = 20
top_p = 0.8
min_p = 0.0
penalty_last_n = 64
penalty_repeat = 1.10
penalty_freq = 0.0
penalty_present = 0.0
seed = 0
chat_template = "chatml"
gpu_layers = -1

[intent]
model_file = "models/intent/intent.bin"

[decide]
engine = "router"
act = 0.90
ask = 0.60
margin = 0.10

[decide.router]
act = 0.90
ask = 0.60
margin = 0.10
witness_only = false

[decide.rules]
witness_only = false

[decide.laya]
bundle_dir = ""
sha256 = ""
threads = 0
cpu_arena = false
prepacking = false
mmap = true

[components]
models_dir = "models"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "8M"
client_max_memory_body_size = "8M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false

[memory]
db_file = "database/memory.db"
schema_file = "database/schema.sql"
catalog_person_table = "catalog_person"
catalog_camera_table = "catalog_camera"
catalog_zone_table = "catalog_zone"
catalog_stream_table = "catalog_stream"
create_face_vec = false
queue_bound = 64
recall_max_tokens = 512
profile_max_tokens = 256
profile_max_facts = 4
profile_stale_seconds = 300
recall_deadline_ms = 200
embedding_model = "models/memory/model.onnx"
embedding_tokenizer = "models/memory/tokenizer.json"
embedding_max_len = 512
embedding_preload = true
embedding_dim = 0
recall_top_k = 4
lexical_min_hits = 4
vector_min_sim = 0.80
vector_margin = 0.05
vector_strict_min_sim = 0.88
vector_small_store_sim = 0.84
semantic_max_facts = 2
vector_dedup_sim = 0.93
chunk_chars = 400
flush_timeout_ms = 60000
compact_wait_ms = 15000
compact_max_tokens = 256
extract_wait_ms = 15000
observe_camera_events = false

[extract]
engine = "nuextract"
model_path = "models/extract/NuExtract-1.5-tiny-Q4_K_M.gguf"
prompt_format = "v1.5"
gpu_layers = -1
lexicon_min_coverage = 0.6
threads = 0
n_ctx = 2048
max_tokens = 512

[extract.gliner]
bundle_dir = ""
sha256 = ""
threads = 0
cpu_arena = false
prepacking = false
mmap = true

[nats]
url = "nats://127.0.0.1:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

[camera]
grpc_target = ""
credential = ""

[guard]
target = "127.0.0.1:7139"
credential = ""

[productivity]
grpc_target = "127.0.0.1:7037"
credential = ""

[modules]
target = "127.0.0.1:7047"
credential = ""

[notifications]
target = "127.0.0.1:7038"
credential = ""

[identity]
credential = ""
