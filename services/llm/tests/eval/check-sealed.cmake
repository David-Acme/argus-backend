file(READ "${GATES}" gates)
string(JSON expected GET "${gates}" ${KEY} sha256)
string(JSON name GET "${gates}" ${KEY} file)
file(SHA256 "${DIR}/${name}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "the ${KEY} set ${name} changed: ${actual} is not the pinned ${expected}")
endif()
message(STATUS "${KEY} set ${name} matches ${expected}")
