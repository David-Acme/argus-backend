[server]
host = "127.0.0.1"
grpc_port = 7040

[rpc.callers]
auth = ""
camera = ""
guard = ""
llm = ""
notification = ""
productivity = ""
sync = ""
voice = ""
settings = ""

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[identity]
host = "0.0.0.0"
port = 7044
plain = false
min_protocol = "TLSv1.2"
db = "database/identity.db"
schema = "services/identity/database/schema.sql"

[cert]
dir = "certs"
ca_cert = "certs/ca.pem"
ca_key = "certs/ca.key"
server_cert = "certs/server.pem"
server_key = "certs/server.key"
leaf_ttl_days = 90
rotation_threshold_days = 30
rotate_check_hours = 24

[stt]
language = "es"

[jwt]
secret = ""

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[auth]
target = "127.0.0.1:7043"
credential = ""

[sync]
control_target = "127.0.0.1:7041"
control_credential = ""

[nats]
url = "nats://127.0.0.1:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

[face]
enabled = true
top_k = 5
match_threshold = 0.50
login_margin = 0.05
liveness_required = true
liveness_threshold = 0.80
liveness_model_dir = "models/face/anti-spoof"

[voiceprint]
enabled = true
model = "models/speaker/3dspeaker_speech_eres2net_sv_en_voxceleb_16k.onnx"
identify_threshold = 0.55
identify_margin = 0.05
min_verify_speech_seconds = 0.8
min_snr_db = 12.0
passive_enabled = true
link_min_occasions = 3
link_min_days = 2
link_dominance = 0.75
window_days = 30
max_profile_samples = 40
call_idle_minutes = 5

[invitation]
lifetime_seconds = 1800

[rate_limit]
enabled = true
window_seconds = 60
max_requests = 10
lockout_threshold = 5
lockout_seconds = 300

[storage]
mode = "s3"

[storage.s3]
endpoint = "http://127.0.0.1:9000"
region = "us-east-1"
bucket = "argus"
access_key = ""
secret_key = ""

[pairing]
paired = false
owner_device = ""

[remote]
tunnel_port = 0
enabled = false
tunnel_profile = false
hostname = ""

[mdns]
enabled = true
name = "Argus"
address = ""

[modules]
target = "127.0.0.1:7047"
credential = ""
