# argus-llm configuration. Copy to config.toml (gitignored) to run.

[server]
host = "127.0.0.1"
port = 7032

[llm]
model_path = "models/llm/LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf"
context_size = 32768
max_tokens = 256
temperature = 0.85
threads = 0
batch_threads = 0
n_batch = 1024
n_ubatch = 512
kv_type = "auto"
flash_attn = "auto"
swa_full = false
top_k = 20
top_p = 0.8
penalty_last_n = 64
penalty_repeat = 1.10
penalty_freq = 0.0
penalty_present = 0.0
seed = 0
chat_template = "chatml"
gpu_layers = -1

[intent]
# An absent file makes the router abstain; every turn stays on tool calling.
model_file = "models/intent/intent.bin"

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "8M"
client_max_memory_body_size = "8M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
