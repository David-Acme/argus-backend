# argus-llm configuration. Copy to config.toml (gitignored) to run.
# LLM-domain keys only (F4-5): the engine knobs mirroring the legacy [llm]
# block plus the internal listener. No database, no JWT, no device keys.

[server]
# Internal plain-HTTP listener. Loopback by default: only the legacy voice
# session calls this wire, and it is never routed through the gateway.
host = "127.0.0.1"
port = 7032

[llm]
# Engine knobs identical to the legacy [llm] block: the shared LlmService
# reads the same keys here as it does in the legacy.
model_path = "models/llm/LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf"
context_size = 32768
max_tokens = 256
temperature = 0.85
threads = 0
batch_threads = 0
n_batch = 1024
n_ubatch = 512
kv_type = "auto"
flash_attn = "auto"
swa_full = false
top_k = 20
top_p = 0.8
penalty_last_n = 64
penalty_repeat = 1.10
penalty_freq = 0.0
penalty_present = 0.0
seed = 0
chat_template = "chatml"
# Tier note: this service derives its capability tier without a Vulkan probe
# (the ncnn-gated probe is compiled out), so -1 keeps the CPU-only default.
# Pin the legacy value here for parity when the legacy offloads to GPU
# (999 on a Vulkan/CUDA host).
gpu_layers = -1

[intent]
# The published fastText classifier in front of the tool loop. An absent file
# makes the router abstain and every turn stays on the LLM's tool calling.
model_file = "models/intent/intent.bin"

# Mirror of the legacy [drogon.app] block; the listener is built by the
# service itself (see argus-llm/src/main.cc).
[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = false
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
client_max_body_size = "8M"
client_max_memory_body_size = "8M"
reuse_port = false
handle_sig_term = true
relaunch_on_error = false
