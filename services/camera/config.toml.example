[server]
host = "127.0.0.1"
grpc_port = 7036

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[camera]
host = "0.0.0.0"
port = 7026
plain = false
min_protocol = "TLSv1.2"
db = "database/camera.db"
schema = "services/camera/database/schema.sql"

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[tapo]
control_port = 443
media_port = 8800
connect_timeout_ms = 3000
request_timeout_ms = 5000
login_attempts = 2
transport = "auto"
talk_framing = "none"
talk_mode = "aec"

[streaming]
go2rtc_bin = "third_party/go2rtc/go2rtc"
go2rtc_config = "go2rtc.yaml"
go2rtc_api = "127.0.0.1:1984"
go2rtc_rtsp = "127.0.0.1:8554"
max_restarts = 8
hub_window_bytes = 131072
hub_chunk_bytes = 16384
hub_grace_ms = 2000
hub_gop_cache_bytes = 2097152
hub_max_subs_per_client = 8
max_viewers_per_camera = 4
max_total_viewers = 8

[tts]
remote_url = "127.0.0.1:7029"
remote_timeout_ms = 30000

[nats]
url = "nats://127.0.0.1:4222"

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[identity]
target = "127.0.0.1:7040"
rpc_secret = ""

[objects]
enabled = false
model = "models/objects"
input_size = 640
conf = 0.45
max_fps_inference = 2.0
active_fps = 6.0
burst_fps = 10.0
burst_ms = 3000
use_vulkan = true

[operator]
aggregation_window_ms = 1000
dwell_alert_ms = 400
dwell_monitor_ms = 12000
dwell_night_ms = 800
cooldown_ms = 30000
night_start = 22
night_end = 6
presence_escalation_frames = 3
zones_from_db = true
zones_refresh_ms = 30000
camera_rescan_ms = 15000
motion_gate = false
motion_min_ratio = 0.002
ignore_static_persons = false
static_box_frames = 8
overlay = false
overlay_dir = "bench-results/operator-overlay"

[actions]
enabled = false

[grpc]
caller_guard = ""
caller_sync = ""
caller_llm = ""
caller_settings = ""

[health]
enabled = true
interval_ms = 60000
dark_threshold = 25.0
bright_threshold = 235.0
blur_threshold = 18.0
scene_diff = 0.35
rebaseline_after_s = 900

[stt]
remote_url = "127.0.0.1:7030"
remote_timeout_ms = 30000
language = "es"

[mdns]
enabled = true
name = "Argus"
address = ""
