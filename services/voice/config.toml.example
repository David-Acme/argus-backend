[server]
host = "127.0.0.1"
health_port = 7035

[internal_tls]
dir = ""
address = "127.0.0.1:7234"

[grpc]
caller_sync = ""
caller_settings = ""
caller_notification = ""

[voice]
opening = "none"
trace_latency = false
use_conversation = false

[identity]
target = "tls:127.0.0.1:7240"
credential = ""

[rtc]
enabled = true
url = "ws://127.0.0.1:7880"
rejoin_grace_ms = 12000
first_join_wait_ms = 60000

[notification]
target = "tls:127.0.0.1:7238"
credential = ""

[camera]
grpc_target = "tls:127.0.0.1:7236"
credential = ""

[sync]
control_target = "tls:127.0.0.1:7241"
control_credential = ""

[guard]
presence_target = "tls:127.0.0.1:7339"
presence_credential = ""

[watch]
enabled = true
list_refresh_ms = 10000
reconnect_ms = 2000
stage1 = "auto"
ring_ms = 2000
post_roll_ms = 1000
wake_max_distance = 2
stt_stage1_max_ms = 2500
stt_stage1_min_ms = 300
stt_stage1_min_snr_db = 6.0
kws_hangover_ms = 400
kws_retry_ms = 5000
min_wake_snr_db = 3.0
fire_debounce_ms = 1500
broadcast_window_ms = 150
broadcast_min_cameras = 3
broadcast_spread_db = 6.0
tv_raise_db = 6.0
echo_tail_ms = 800
echo_correlation = 0.6
echo_raise_db = 6.0
echo_max_lag_ms = 1000
floor_rise_db_per_s = 0.5
floor_fall_db_per_s = 10.0
fire_log_size = 200
arbitration_window_ms = 400
stage2_candidates = 2
weight_wake = 1.0
weight_snr = 0.1
weight_stage2 = 1.0
gain_weight = 0.5
gain_alpha = 0.1
end_silence_ms = 700
incomplete_hold_ms = 2000
max_turn_ms = 30000
ack_after_ms = 1500
fail_after_ms = 8000
idle_close_ms = 20000
max_length_ms = 600000
resumable_ms = 180000
reply_gap_ms = 700
camera_drop_ms = 3000
face_window_ms = 1500
visitor_consent_asks = 2
visitor_consent_max_words = 6

[stt]
remote_url = "127.0.0.1:7030"
remote_timeout_ms = 30000
language = "es"

[tts]
remote_url = "127.0.0.1:7029"
remote_timeout_ms = 30000

[llm]
remote_url = "127.0.0.1:7032"
remote_timeout_ms = 120000
grpc_credential = ""

[vad]
threshold = 0.45
neg_threshold = 0.30
min_speech_frames = 5
min_silence_frames = 12
max_turn_frames = 750
pre_roll_frames = 10
min_turn_ms = 240
min_mean_prob = 0.35
denoise = true
denoise_gate_rms = 0.0035
gate_margin_db = 30.0
gate_speech_prob = 0.5
gate_held_ms = 160
gate_floor_windows = 300
gate_floor_percentile = 0.2
barge_threshold = 0.7
barge_min_frames = 6
barge_guard_ms = 300
duck_threshold = 0.5
duck_min_frames = 3
duck_release_frames = 10
