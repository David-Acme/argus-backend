[server]
host = "127.0.0.1"
grpc_port = 7034
health_port = 7035

[grpc]
caller_sync = ""
caller_settings = ""
caller_notification = ""

[identity]
target = "127.0.0.1:7040"
rpc_secret = ""

[rtc]
enabled = true
url = "ws://127.0.0.1:7880"
rejoin_grace_ms = 20000
first_join_wait_ms = 60000

[notification]
target = "127.0.0.1:7038"
credential = ""

[stt]
remote_url = "127.0.0.1:7030"
remote_timeout_ms = 30000
language = "es"

[tts]
remote_url = "127.0.0.1:7029"
remote_timeout_ms = 30000

[llm]
remote_url = "127.0.0.1:7032"
remote_timeout_ms = 120000

[vad]
threshold = 0.45
neg_threshold = 0.25
min_speech_frames = 5
min_silence_frames = 12
max_turn_frames = 750
pre_roll_frames = 10
min_turn_ms = 240
min_mean_prob = 0.35
denoise = true
denoise_gate_rms = 0.0035
barge_threshold = 0.7
barge_min_frames = 8
barge_guard_ms = 300
