[server]
host = "127.0.0.1"
health_port = 7035

[internal_tls]
dir = ""
address = "127.0.0.1:7234"

[grpc]
caller_sync = ""
caller_settings = ""
caller_notification = ""

[voice]
opening = "none"
trace_latency = false
use_conversation = false

[identity]
target = "tls:127.0.0.1:7240"
credential = ""

[rtc]
enabled = true
url = "ws://127.0.0.1:7880"
rejoin_grace_ms = 12000
first_join_wait_ms = 60000

[notification]
target = "tls:127.0.0.1:7238"
credential = ""

[stt]
remote_url = "127.0.0.1:7030"
remote_timeout_ms = 30000
language = "es"

[tts]
remote_url = "127.0.0.1:7029"
remote_timeout_ms = 30000

[llm]
remote_url = "127.0.0.1:7032"
remote_timeout_ms = 120000
grpc_credential = ""

[vad]
threshold = 0.45
neg_threshold = 0.30
min_speech_frames = 5
min_silence_frames = 12
max_turn_frames = 750
pre_roll_frames = 10
min_turn_ms = 240
min_mean_prob = 0.35
denoise = true
denoise_gate_rms = 0.0035
gate_margin_db = 30.0
gate_speech_prob = 0.5
gate_held_ms = 160
gate_floor_windows = 300
gate_floor_percentile = 0.2
barge_threshold = 0.7
barge_min_frames = 6
barge_guard_ms = 300
duck_threshold = 0.5
duck_min_frames = 3
duck_release_frames = 10
