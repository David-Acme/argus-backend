[server]
host = "127.0.0.1"
grpc_port = 7038

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[notification]
host = "0.0.0.0"
port = 7028
plain = false
min_protocol = "TLSv1.2"

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[notifications]
db = "database/notification.db"
schema = "services/notification/database/schema.sql"
ack_window_s = 86400
selftest_interval_s = 300
budget_per_hour = 6
silent_start = -1
silent_end = -1
guard_heartbeat_timeout_s = 30
fallback_min_score_median = 0.3
fallback_min_dwell_ms = 1000
fallback_suppress_known = true
fallback_retention_days = 90
lang = "es"

[calls]
enabled = true
call_gap_s = 300
max_calls_per_hour = 4
arrival_absence_s = 10800
scheduled_late_s = 900
retention_days = 30

[identity]
target = "127.0.0.1:7040"
rpc_secret = ""

[sync]
control_target = "127.0.0.1:7041"
control_secret = ""

[voice]
target = "127.0.0.1:7034"
credential = ""

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[grpc]
caller_guard = ""
caller_sync = ""
caller_settings = ""
caller_voice = ""
caller_llm = ""
caller_productivity = ""

[nats]
url = "nats://127.0.0.1:4222"

[push]
enabled = false

[mdns]
enabled = true
name = "Argus"
address = ""
