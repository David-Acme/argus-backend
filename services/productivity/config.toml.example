[server]
host = "127.0.0.1"
grpc_port = 7037

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[productivity]
host = "0.0.0.0"
port = 7027
plain = false
min_protocol = "TLSv1.2"
db = "database/productivity.db"
schema = "services/productivity/database/schema.sql"

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
trust_forwarded_for = false
trusted_proxy_ips = ""

[identity]
target = "127.0.0.1:7040"
rpc_secret = ""

[agenda]
enabled = true

[notifications]
target = "127.0.0.1:7038"
credential = ""

[nats]
url = "nats://127.0.0.1:4222"

[grpc]
caller_sync = ""

[mdns]
enabled = true
name = "Argus"
address = ""
