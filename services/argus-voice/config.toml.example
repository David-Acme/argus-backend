# argus-voice configuration. Copy to config.toml (gitignored) to run.
# Pure gRPC voice service; no database, the only model is the in-process silero VAD.

[server]
host = "127.0.0.1"
grpc_port = 7034
health_port = 7035

# Empty disables the spoken-name persist (logged, session continues).
[identity]
target = "127.0.0.1:7040"

[stt]
remote_url = "127.0.0.1:7030"
remote_timeout_ms = 30000
# Fallback when the stream identity carries VOICE_LANGUAGE_SYSTEM.
language = "es"

[tts]
remote_url = "127.0.0.1:7029"
remote_timeout_ms = 30000

[llm]
remote_url = "127.0.0.1:7032"
remote_timeout_ms = 120000

[vad]
threshold = 0.45
neg_threshold = 0.25
min_speech_frames = 5
min_silence_frames = 12
max_turn_frames = 750
pre_roll_frames = 10
min_turn_ms = 240
min_mean_prob = 0.35
denoise = true
denoise_gate_rms = 0.0035
