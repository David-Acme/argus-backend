{
  "subject": "argus.tunnel.v1.link",
  "homeId": "e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0",
  "domain": "argus-tunnel.lynk.page",
  "steps": [
    {
      "name": "reset",
      "publish": [{ "link": "down", "since": 1790000000 }],
      "expect": "any",
      "waitSeconds": 7
    },
    {
      "name": "up",
      "publish": [{ "link": "up", "since": 1790000001 }],
      "expect": {
        "operation": 13,
        "option": "user",
        "remote": {
          "homeId": "e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0",
          "domain": "argus-tunnel.lynk.page",
          "link": "up",
          "since": 1790000001
        }
      },
      "waitSeconds": 10
    },
    {
      "name": "back-inside-the-window",
      "publish": [
        { "link": "down", "since": 1790000002 },
        { "link": "up", "since": 1790000003 }
      ],
      "expect": null,
      "waitSeconds": 8
    },
    {
      "name": "down",
      "publish": [{ "link": "down", "since": 1790000004 }],
      "expect": {
        "operation": 13,
        "option": "user",
        "remote": {
          "homeId": "e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0",
          "domain": "argus-tunnel.lynk.page",
          "link": "down",
          "since": 1790000004
        }
      },
      "waitSeconds": 10
    },
    {
      "name": "trailing",
      "publish": [
        { "link": "connecting", "since": 1790000005 },
        { "link": "up", "since": 1790000006 }
      ],
      "expect": {
        "operation": 13,
        "option": "user",
        "remote": {
          "homeId": "e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0",
          "domain": "argus-tunnel.lynk.page",
          "link": "up",
          "since": 1790000006
        }
      },
      "waitSeconds": 10,
      "minGapSeconds": 4
    }
  ]
}
