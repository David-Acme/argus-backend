[server]
host = "127.0.0.1"
grpc_port = 7041

[rpc.callers]
identity = ""
notification = ""

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[sync]
host = "0.0.0.0"
port = 7025
plain = false
min_protocol = "TLSv1.2"
db = "database/sync.db"
schema = "services/sync/database/schema.sql"
audit_retention_days = 90

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[camera]
grpc_target = "127.0.0.1:7036"
credential = ""

[identity]
target = "127.0.0.1:7040"
credential = ""

[productivity]
grpc_target = "127.0.0.1:7037"
credential = ""

[voice]
target = "127.0.0.1:7034"
credential = ""

[rtc]
enabled = true
api_key = ""
api_secret = ""
server_url = "http://127.0.0.1:7880"
public_url = ""
public_port = 7046
token_ttl_seconds = 60
max_concurrent_calls = 2

[notifications]
grpc_target = "127.0.0.1:7038"
credential = ""

[jwt]
secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "credential"
lan_networks = ""

[guard]
presence_target = "127.0.0.1:7139"
presence_credential = ""

[heartbeat]
interval_seconds = 60
grace_minutes = 45
socket_grace_seconds = 180
guard_stale_seconds = 90
push_interval_seconds = 900
refill_seconds = 300

[push]
enabled = false

[nats]
url = "nats://127.0.0.1:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

[mdns]
enabled = true
name = "Argus"
address = ""

[auth]
credential = ""
