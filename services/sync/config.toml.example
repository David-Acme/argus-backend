[server]
host = "127.0.0.1"
grpc_port = 7041

[drogon.app]
number_of_threads = 0
enable_session = false
document_root = "./"
use_sendfile = true
use_gzip = true
use_brotli = false
static_files_cache_time = 5
idle_connection_timeout = 60
enable_server_header = true
enable_date_header = true
keepalive_requests = 0
pipelining_requests = 0
gzip_static = true
br_static = true
client_max_body_size = "60M"
client_max_memory_body_size = "16M"
client_max_websocket_message_size = "128K"
reuse_port = false
enabled_compressed_request = false
enable_request_stream = false
handle_sig_term = true
relaunch_on_error = false

[sync]
host = "0.0.0.0"
port = 7025
plain = false
min_protocol = "TLSv1.2"
db = "database/sync.db"
schema = "services/sync/database/schema.sql"
audit_retention_days = 90
control_secret = ""

[cert]
server_cert = "certs/server.pem"
server_key = "certs/server.key"

[camera]
grpc_target = "127.0.0.1:7036"

[identity]
target = "127.0.0.1:7040"
rpc_secret = ""

[productivity]
grpc_target = "127.0.0.1:7037"

[voice]
target = "127.0.0.1:7034"

[notifications]
grpc_target = "127.0.0.1:7038"
credential = ""

[jwt]
secret = ""
refresh_secret = ""
access_ttl_minutes = 15
refresh_ttl_days = 30

[device]
fingerprint_secret = ""
identity_mode = "ip"

[nats]
url = "nats://127.0.0.1:4222"
reconnect_wait_ms = 2000
max_reconnects = 60

[mdns]
enabled = true
name = "Argus"
address = ""
